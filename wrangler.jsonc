{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psa-pokemon",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cms",
      "database_id": "d1c6ab65-f71b-4ebb-857a-007c723958dd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "psa-pokemon"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "R2_PUBLIC_URL": "https://pub-d6d8fdb3e42349a8aaa28b4a9d79337c.r2.dev"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "API_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1000",
        "simple": {
          "limit": 100,
          "period": 60
        }
      },
      {
        "name": "FREE_USER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 100,
          "period": 60
        }
      },
      {
        "name": "PAID_USER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 1000,
          "period": 60
        }
      }
    ]
  }
}
