{
  "name": "psa-pokemon",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "husky && npx gitnexus analyze",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "release": "commit-and-tag-version",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate && for dir in migrations/*/; do [ -f \"$dir/migration.sql\" ] && cp -n \"$dir/migration.sql\" \"migrations/$(basename $dir).sql\" 2>/dev/null; done",
    "db:apply:local": "wrangler d1 migrations apply cms",
    "db:apply:remote": "wrangler d1 migrations apply cms --remote",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:admin:remote": "node scripts/seed-admin.mjs --remote",
    "setup:wrangler": "node scripts/setup-wrangler.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hono/zod-openapi": "1.2.2",
